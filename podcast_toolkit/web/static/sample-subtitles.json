{
  "version": 1,
  "duration": 24.0,
  "_note": "丟棄式原型用 demo 字幕；start/end 對齊 sample-waveform.json 的人聲段落（silences 之間）。",
  "subs": [
    { "start": 0.4, "end": 2.2, "text": "欸，今天想跟大家聊一個蠻有趣的主題" },
    { "start": 2.7, "end": 3.9, "text": "就是關於做 Podcast 這件事" },
    {
      "start": 4.25,
      "end": 6.65,
      "text": "很多人以為錄音只要有支麥克風就好了"
    },
    { "start": 7.35, "end": 8.25, "text": "但根本不是這樣" },
    { "start": 8.55, "end": 10.15, "text": "後製這一關才是真正的魔王" },
    {
      "start": 11.05,
      "end": 13.05,
      "text": "光把逐字稿的斷句弄對就要花好幾個小時"
    },
    { "start": 13.45, "end": 14.55, "text": "更不要說對齊時間軸了" },
    {
      "start": 15.15,
      "end": 17.05,
      "text": "所以我們才想說乾脆自己做一套工具"
    },
    { "start": 17.37, "end": 18.77, "text": "讓剪輯可以又快又直覺" },
    {
      "start": 19.57,
      "end": 21.77,
      "text": "你看現在剪掉一段字幕就會自動接上去"
    },
    { "start": 22.22, "end": 23.22, "text": "是不是很方便呢" }
  ]
}
