#!/bin/bash
# 提交前自動檢查：只在有改到對應檔案時才跑，沒改就秒過。
# 想硬提交略過檢查：git commit --no-verify
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# 這次 commit 暫存了哪些檔
STAGED="$(git diff --cached --name-only --diff-filter=ACM)"

# ── 1. 前端語法檢查：只檢查這次動到的 static/*.js ──────────────────
# 用 checkModuleSyntax 而不是 new Function：後者是把來源當「函式體」解析，
# 頂層的 import / export 一律當語法錯誤 —— Phase 3 把 app.js 拆成 ES module
# 之後，舊寫法會無條件擋下每一次提交（app.js 其實完全正常）。
# checkModuleSyntax 只解析不執行，語法有錯就丟例外（exit≠0）。
JS_STAGED="$(echo "$STAGED" | grep '^podcast_toolkit/web/static/.*\.js$' || true)"
if [ -n "$JS_STAGED" ]; then
  JSC="/System/Library/Frameworks/JavaScriptCore.framework/Versions/Current/Helpers/jsc"
  if [ -x "$JSC" ]; then
    for f in $JS_STAGED; do
      [ -f "$f" ] || continue   # 這次是刪檔就跳過
      echo "→ 檢查 $f 語法…"
      if ! "$JSC" -e "checkModuleSyntax(readFile('$f'))" >/dev/null 2>&1; then
        echo "✗ $f 語法錯誤，已擋下提交。修好再 commit（或 --no-verify 略過）。"
        exit 1
      fi
    done
  fi
fi

# ── 2. 快測：只在動到 .py 時，跑上次失敗優先、遇錯即停 ─────────────
# 解譯器要自己挑，不能直接用 PATH 上的 python3：本專案宣告的執行環境是 3.9，
# 但 PATH 上常是 Homebrew 的新版（本機 3.14.6），用它跑會撞到與改動無關的
# 環境紅（tests/test_dashboard_fault_tolerance.py 兩測）—— 結果是每次提交都得
# --no-verify，護欄實質失效。優先序：PODCAST_PY 環境變數 > 啟用中的 venv >
# /usr/bin/python3（macOS 內建 3.9）> PATH 的 python3。
if echo "$STAGED" | grep -q '\.py$'; then
  PY="${PODCAST_PY:-}"
  if [ -z "$PY" ]; then
    if [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
      PY="$VIRTUAL_ENV/bin/python"
    elif [ -x /usr/bin/python3 ]; then
      PY="/usr/bin/python3"
    else
      PY="python3"
    fi
  fi
  # 挑到的解譯器沒有 pytest 就退回 PATH 的 python3，但要吵出來（不靜默降級）
  if ! "$PY" -c "import pytest" >/dev/null 2>&1; then
    echo "! $PY 沒有 pytest，退回 PATH 的 python3（$(python3 -V 2>&1)）；"
    echo "  想指定解譯器：PODCAST_PY=/path/to/python git commit …"
    PY="python3"
  fi
  echo "→ 跑快測（$("$PY" -V 2>&1)：pytest -x --ff）…"
  if ! "$PY" -m pytest -q tests/ -x --ff >/dev/null 2>&1; then
    echo "✗ 測試沒過，已擋下提交。跑 $PY -m pytest tests/ -x --ff 看細節（或 --no-verify 略過）。"
    exit 1
  fi
fi

echo "✓ 提交前檢查通過"
